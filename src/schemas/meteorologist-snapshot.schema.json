{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meteorologist snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "text", "hasAlert", "date"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "text": {
      "type": "string",
      "maxLength": 1000
    },
    "hasAlert": {
      "type": "boolean"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    }
  }
}
