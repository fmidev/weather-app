{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Announcements",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "content", "link"],
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      },
      "type": {
        "type": "string",
        "enum": ["Maintenance", "Crisis"]
      },
      "content": {
        "type": "string",
        "maxLength": 1000
      },
      "link": {
        "type": "string",
        "maxLength": 1000,
        "format": "uri",
        "pattern": "^https?://"
      }
    }
  }
}
