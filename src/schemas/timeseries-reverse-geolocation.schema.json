{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smartmet Server timeseries reverse geolocation",
  "type": "object",
  "propertyNames": {
    "maxLength": 12
  },
  "patternProperties": {
    "^-?[0-9]+$": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "latitude",
          "longitude",
          "region",
          "country",
          "iso2",
          "localtz"
        ],
        "properties": {
          "name": { "type": "string", "maxLength": 400 },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "region": { "type": "string", "maxLength": 400 },
          "country": { "type": "string", "maxLength": 400 },
          "iso2": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "maxLength": 2
          },
          "localtz": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 50
          }
        }
      }
    }
  },
  "additionalProperties": false
}
