{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeseries UV Forecast",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["epochtime", "uvCumulated"],
    "properties": {
      "epochtime": {
        "type": "integer"
      },
      "uvCumulated": {
        "type": ["number", "null"]
      }
    }
  }
}
