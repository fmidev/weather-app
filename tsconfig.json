{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "target": "ES2022",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-native-nitro-geolocation/compat": [
        "./node_modules/react-native-nitro-geolocation/src/compat/index.tsx"
      ],
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@navigators/*": ["./src/navigators/*"],
      "@network/*": ["./src/network/*"],
      "@screens/*": ["./src/screens/*"],
      "@store/*": ["./src/store/*"],
      "@utils/*": ["./src/utils/*"],
      "@config": ["./src/config"],
      "@i18n": ["./i18n"]
    }
  },
  "exclude": ["node_modules", "e2e", "**/Pods"]
}
