{
  "name": "MobileWeather",
  "version": "6.2.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --verbose",
    "test:integration:live": "jest --config jest.live.config.js --runInBand --watchman=false --verbose",
    "lint": "tsc --noEmit && eslint .",
    "lint-fix": "eslint --fix .",
    "lint:js": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepare": "husky install",
    "e2e:test:ios": "detox test -c ios",
    "e2e:test:android": "detox test -c android",
    "e2e:build:ios": "detox build -c ios",
    "e2e:build:android": "detox build -c android",
    "buildAndroidRelease": "cd android && ./gradlew clean bundleRelease",
    "server": "cd mockserver && node server.mjs",
    "server:watch": "cd mockserver && nodemon server.mjs"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@logicwind/react-native-matomo-tracker": "0.3.13",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native-async-storage/async-storage": "2.1.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/stack": "7.12.1",
    "@shopify/react-native-skia": "2.14.0",
    "@testing-library/react-native": "8.0.0",
    "@types/supercluster": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axios": "1.20.0",
    "axios-cache-interceptor": "1.13.0",
    "fast-xml-parser": "5.11.2",
    "geolib": "3.3.14",
    "i18next": "26.5.11",
    "moment": "2.31.0",
    "moment-timezone": "0.6.5",
    "react": "19.3.0",
    "react-i18next": "15.7.4",
    "react-native": "0.88.0",
    "react-native-config": "1.7.2",
    "react-native-default-preference": "1.4.4",
    "react-native-gesture-handler": "3.4.0",
    "react-native-haptic-feedback": "1.13.1",
    "react-native-launch-arguments": "4.1.1",
    "react-native-linear-gradient": "2.8.3",
    "react-native-localize": "3.7.2",
    "react-native-maps": "1.29.11",
    "react-native-marked": "8.3.2",
    "react-native-mmkv": "3.3.3",
    "react-native-nitro-geolocation": "1.4.3",
    "react-native-nitro-modules": "0.37.1",
    "react-native-permissions": "5.6.3",
    "react-native-raw-bottom-sheet": "2.2.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "1.5.3",
    "react-native-url-polyfill": "4.0.0",
    "react-native-vector-icons": "10.3.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-redux": "8",
    "redux": "4.1.2",
    "redux-persist": "6.0.0",
    "redux-thunk": "2.4.0",
    "reselect": "4.1.4",
    "supercluster": "7.1.4",
    "victory-native": "42.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "8.0.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "29.5.14",
    "@types/proj4": "2.19.0",
    "@types/react": "19.2.0",
    "@types/react-native-vector-icons": "6.4.18",
    "@types/react-redux": "7.1.33",
    "@types/react-test-renderer": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "babel-eslint": "10.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "detox": "20.51.4",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "express": "4.22.1",
    "husky": "7.0.4",
    "ip": "2.0.1",
    "jest": "29.7.0",
    "jest-circus": "29.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --no-warn-ignored"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/)+defaultConfig$": "<rootDir>/defaultConfig_unit_tests.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/__tests__/integration/live/"
    ],
    "transform": {
      "/node_modules/react-native-config/index.js": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native(-.*)?|@react-native(-community)?)/)"
    ],
    "testRegex": ".*\\.test\\.ts.*$"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "yarn@1.22.22"
}
